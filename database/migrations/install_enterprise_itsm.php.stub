    protected function backfillTickets(string $tickets, string $sequences): void
    {
        $prefixes = config('laravel_ticket.numbering.prefixes', [
            'incident' => 'INC',
            'service_request' => 'REQ',
            'problem' => 'PRB',
            'change' => 'CHG',
        ]);
        $pad = (int) config('laravel_ticket.numbering.pad', 6);
        $counters = [];

        DB::table($tickets)->whereNull('uuid')->orderBy('id')->lazyById()->each(function ($ticket) use ($tickets) {
            DB::table($tickets)->where('id', $ticket->id)->update([
                'uuid' => (string) Str::uuid(),
            ]);
        });

        DB::table($tickets)->whereNull('ticket_number')->orderBy('id')->lazyById()->each(function ($ticket) use ($tickets, $prefixes, $pad, &$counters) {
            $prefix = $prefixes[$ticket->type] ?? 'INC';
            $counters[$prefix] = ($counters[$prefix] ?? 0) + 1;

            DB::table($tickets)->where('id', $ticket->id)->update([
                'ticket_number' => sprintf('%s-%0'.$pad.'d', $prefix, $counters[$prefix]),
            ]);
        });

        foreach ($counters as $prefix => $current) {
            DB::table($sequences)->updateOrInsert(
                ['prefix' => $prefix],
                ['current' => $current, 'created_at' => now(), 'updated_at' => now()]
            );
        }
    }

    protected function widenMessage(string $table): void
    {
        $driver = Schema::getConnection()->getDriverName();
        $grammar = Schema::getConnection()->getQueryGrammar();
        $wrappedTable = $grammar->wrapTable($table);
        $column = $grammar->wrap('message');

        if (in_array($driver, ['mysql', 'mariadb'], true)) {
            DB::statement("ALTER TABLE {$wrappedTable} MODIFY {$column} TEXT NULL");
        } elseif ($driver === 'pgsql') {
            DB::statement("ALTER TABLE {$wrappedTable} ALTER COLUMN {$column} TYPE TEXT");
        } elseif ($driver === 'sqlsrv') {
            DB::statement("ALTER TABLE {$wrappedTable} ALTER COLUMN {$column} NVARCHAR(MAX) NULL");
        }
    }
